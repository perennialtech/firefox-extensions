{
  "manifest_version": 3,
  "name": "X Account Location Flags",
  "version": "0.1.0",
  "description": "Show an account's X 'based in' country beside its username.",
  "browser_specific_settings": {
    "gecko": {
      "id": "x-account-location-flags@perennialtech",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
