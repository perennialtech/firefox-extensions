{
  "manifest_version": 3,
  "name": "Reddit Direct Images",
  "version": "0.1.0",
  "description": "Open Reddit-hosted images as images, not Reddit media pages.",
  "permissions": ["webRequest", "webRequestBlocking"],
  "host_permissions": [
    "https://i.redd.it/*",
    "https://preview.redd.it/*",
    "https://cf.preview.redd.it/*",
    "https://external-preview.redd.it/*",
    "https://www.reddit.com/*",
    "https://reddit.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "reddit-direct-images@perennialtech"
    }
  }
}
